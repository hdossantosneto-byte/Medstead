# SQLite file used by Prisma. Fine for local and a first deploy.
DATABASE_URL="file:./dev.db"

# Sign session cookies. Use a long random string in production.
#   openssl rand -base64 48
SESSION_SECRET="change-me-generate-a-long-random-string"

# Shared PIN for the /ops desk (status + invoice). Not a customer password.
OPS_PIN="local-ops"
