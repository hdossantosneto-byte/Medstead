DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# iOS Capacitor shell — replace with the live HTTPS origin when Hairson has one.
# Placeholder is not a public host. Do not use bolt.host as production.
CAPACITOR_SERVER_URL="https://YOUR-LIVE-HTTPS-HOST.example"

# Call Center POST /api/calls — shared secret. Authorization: Bearer <token> or x-call-center-token.
# Leave empty to disable token ingest (staff session still works).
CALL_CENTER_INGEST_TOKEN=""
